<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">


    <changeSet id="1-add-faculty-color" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="faculty" columnName="color"/>
            </not>
        </preConditions>
        <addColumn tableName="faculty">
            <column name="color" type="VARCHAR(100)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>


    <changeSet id="2-create-idx-student-name" author="developer">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="student"/>
            <columnExists tableName="student" columnName="name"/>
            <not>
                <indexExists tableName="student" indexName="idx_student_name"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_student_name" tableName="student">
            <column name="name"/>
        </createIndex>
    </changeSet>


    <changeSet id="3-create-idx-faculty-name-color" author="developer">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="faculty"/>
            <columnExists tableName="faculty" columnName="name"/>
            <columnExists tableName="faculty" columnName="color"/>
            <not>
                <indexExists tableName="faculty" indexName="idx_faculty_name_color"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_faculty_name_color" tableName="faculty">
            <column name="name"/>
            <column name="color"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
